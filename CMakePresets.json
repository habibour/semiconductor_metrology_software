{
    "version": 4,
    "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
    "configurePresets": [
        {
            "name": "dev",
            "displayName": "Dev (Debug)",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SSIM_BUILD_TESTS": "ON",
                "SSIM_ENABLE_SECSGEM": "ON"
            }
        },
        {
            "name": "qt",
            "displayName": "Dev with Qt panel (Debug)",
            "binaryDir": "${sourceDir}/build-qt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "SSIM_BUILD_TESTS": "ON",
                "SSIM_BUILD_QT": "ON",
                "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qtbase",
                "CMAKE_OSX_ARCHITECTURES": "arm64"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "SSIM_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "tsan",
            "displayName": "ThreadSanitizer",
            "binaryDir": "${sourceDir}/build-tsan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SSIM_SANITIZER": "thread",
                "SSIM_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "asan",
            "displayName": "AddressSanitizer",
            "binaryDir": "${sourceDir}/build-asan",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "SSIM_SANITIZER": "address",
                "SSIM_BUILD_TESTS": "ON"
            }
        }
    ]
}
